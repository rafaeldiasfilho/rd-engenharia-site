# Preencha na Vercel (Settings > Environment Variables) e, se for testar localmente, em um arquivo .env.local
# A chave "anon" (publishable) é pública por desenho; quem protege os dados são as regras do banco (RLS).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
